# 复制为 .env 后填入真实值；本文件不含任何真实密钥，可安全提交
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_MODEL=MiniMax-M3.1-Flash
DEFAULT_EFFORT=medium

# 会话签名与加密用；至少 32 位随机串
SECRET_KEY=
# 管理员密码：只用于 /admin 登录，与访客无关
ADMIN_NICKNAME=泉达
ADMIN_PASSWORD=

# 每位访客每天最多 20 次 AI 调用（对话一轮算一次，生成一次算一次）
DAILY_CALL_QUOTA=20
SESSION_TTL_DAYS=30
ADMIN_SESSION_HOURS=12

# 数据目录：线上保持默认 /opt/da-data（实测跨发布保留），本地开发自动用 app/var
# DATA_DIR=/opt/da-data

MAX_UPLOAD_BYTES=20971520
MAX_VISITOR_BYTES=209715200
FILE_RETAIN_DAYS=30

# 公网来源（反向代理会改写 Host，填了同源校验更稳）
# PUBLIC_ORIGIN=https://your-app.app.workbuddy.host
